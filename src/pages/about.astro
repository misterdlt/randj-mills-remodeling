---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import CTABanner from '../components/CTABanner.astro'; import { pageUrl } from '../utils/paths';
---
<Layout title="About R&J Mills Remodeling | Louisville, KY Contractor" description="Meet R&J Mills Remodeling, a Louisville-area contractor focused on thoughtful planning, detailed craftsmanship, and complete home improvements.">
  <Header /><main id="main-content">
    <section class="page-hero"><div class="container"><p class="page-label">About R&amp;J Mills</p><h1 class="page-title">Your home deserves thoughtful work.</h1></div></section>
    <section class="section story"><div class="container story-grid">
      <div class="story-image" data-reveal><img src={pageUrl('images/kitchen-grey-3.jpg')} alt="Detailed kitchen renovation completed by R&J Mills Remodeling" width="768" height="1024" /><span>Louisville, Kentucky</span></div>
      <div data-reveal><p class="section-label">Our approach</p><h2 class="section-title">A better space starts with listening.</h2><p class="lead">R&amp;J Mills Remodeling helps homeowners create spaces that match their style, support their routines, and feel built for the long term.</p><p>We bring interior and exterior remodeling under one roof—from kitchens, baths, and basements to decks, porches, windows, and exterior improvements. Every project begins with your goals and moves forward with careful attention to the details that make a finished space feel complete.</p><p>Based in Louisville, we understand the range of home styles found across the city and nearby communities. Our aim is simple: clear communication, dependable craftsmanship, and a finished result you are proud to live with.</p><a href={pageUrl('gallery')} class="btn btn-primary">Explore our projects</a></div>
    </div></section>
    <section class="values section"><div class="container"><p class="section-label">What guides the work</p><div class="value-grid"><article data-reveal><span>01</span><h2>Listen first</h2><p>Your needs, priorities, and home shape the plan from day one.</p></article><article data-reveal><span>02</span><h2>Build carefully</h2><p>Strong preparation and close attention to detail support a lasting result.</p></article><article data-reveal><span>03</span><h2>Finish well</h2><p>The final details matter. We want the whole space to feel considered.</p></article></div></div></section>
    <CTABanner />
  </main><Footer />
</Layout>
<style>
  .story-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(50px,9vw,120px);align-items:center}.story-image{position:relative;padding:0 28px 28px 0}.story-image::before{content:'';position:absolute;inset:28px 0 0 28px;background:var(--orange)}.story-image img{position:relative;width:100%;height:620px;object-fit:cover}.story-image span{position:absolute;right:-44px;top:50%;transform:rotate(90deg);font-size:.67rem;letter-spacing:.18em;text-transform:uppercase;font-weight:800}.lead{font-size:1.3rem;font-weight:700;color:var(--text)}.story p:not(.section-label){color:var(--muted)}.story .btn{margin-top:16px}.values{background:var(--paper)}.value-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border)}.value-grid article{background:var(--paper);padding:40px}.value-grid span{color:var(--orange);font-size:.7rem;letter-spacing:.14em}.value-grid h2{font-size:2rem;text-transform:uppercase;margin:36px 0 14px}.value-grid p{color:var(--muted);margin:0}@media(max-width:800px){.story-grid,.value-grid{grid-template-columns:1fr}.story-image img{height:500px}.story-image span{display:none}}@media(max-width:520px){.story-image img{height:420px}}
</style>
