---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import { serviceAreas, type ServiceArea } from '../../data/areas';
import { pageUrl } from '../../utils/paths';

export function getStaticPaths() {
  return serviceAreas.map(area => ({ params: { slug: area.slug }, props: { area } }));
}

interface Props { area: ServiceArea; }
const { area } = Astro.props;
const otherAreas = serviceAreas.filter(item => item.slug !== area.slug);
const services = [
  { title: 'Kitchen remodeling', image: pageUrl('images/kitchen-grey-2.jpg'), copy: `Kitchen remodeling in ${area.name} can include layout changes, cabinet and countertop updates, backsplashes, soffit removal, and appliance coordination.` },
  { title: 'Bathroom remodeling', image: pageUrl('images/shower2.jpg'), copy: `Our ${area.name} bathroom remodeling services include custom tile, walk-in and curbless showers, tub conversions, heated floors, glass, and plumbing reconfiguration.` },
  { title: 'Interior renovations', image: pageUrl('images/basement.jpg'), copy: `Create more useful space through basement finishing, wall removal, flooring, painting, staining, and interior door installation in your ${area.name} home.` },
  { title: 'Exterior remodeling', image: pageUrl('images/deck2.jpg'), copy: `Improve outdoor living and curb appeal with custom decks, covered porches, fencing, windows, roofing, gutters, and exterior repairs.` },
];
const faqs = [
  { q: `What remodeling services do you offer in ${area.name}?`, a: `R&J Mills Remodeling provides kitchen remodeling, bathroom renovation, basement finishing, interior improvements, custom decks, covered porches, fencing, windows, roofing, gutters, and related exterior work in ${area.name}.` },
  { q: `Can you help plan a ${area.name} remodeling project?`, a: `Yes. We start by discussing the space, your priorities, and the work you are considering. We can then define an appropriate scope for ${area.faqFocus}.` },
  { q: `How can I request a remodeling quote in ${area.name}?`, a: 'Call 502-649-6975 or send your project details through the contact page. Include the property location, type of project, and the best way to reach you.' },
];
const schemas = [
  { '@context':'https://schema.org', '@type':'Service', name:`Home Remodeling in ${area.name}, ${area.region}`, serviceType:['Kitchen remodeling','Bathroom remodeling','Interior remodeling','Exterior remodeling'], areaServed:{ '@type':'Place', name:`${area.name}, ${area.region}` }, provider:{ '@id':'https://randjmills.com/#business' }, url:`https://randjmills.com/areas/${area.slug}` },
  { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem', position:1, name:'Home', item:'https://randjmills.com/' },{ '@type':'ListItem', position:2, name:'Areas We Serve', item:'https://randjmills.com/areas' },{ '@type':'ListItem', position:3, name:`${area.name}, KY`, item:`https://randjmills.com/areas/${area.slug}` }] },
  { '@context':'https://schema.org', '@type':'FAQPage', mainEntity:faqs.map(item => ({ '@type':'Question', name:item.q, acceptedAnswer:{ '@type':'Answer', text:item.a } })) },
];
---
<Layout title={`Home Remodeling in ${area.name}, KY | R&J Mills`} description={`${area.name}, KY kitchen, bathroom, interior, and exterior remodeling by R&J Mills. Explore services and request a home remodeling quote.`} schema={schemas} image={pageUrl('images/kitchen-grey-2.jpg')}>
  <Header /><main id="main-content">
    <section class="local-hero"><div class="hero-image"></div><div class="hero-overlay"></div><div class="container hero-content"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={pageUrl()}>Home</a><span>/</span><a href={pageUrl('areas')}>Areas</a><span>/</span><span>{area.name}</span></nav><p class="page-label">Remodeling contractor serving {area.name}</p><h1>Home remodeling in {area.name}, KY</h1><p>{area.lead}</p><div class="hero-actions"><a class="btn btn-primary" href={pageUrl('contact')}>Request a free quote</a><a class="btn btn-outline" href="tel:+15026496975">Call 502-649-6975</a></div></div></section>

    <section class="section local-intro"><div class="container intro-grid"><div data-reveal><p class="section-label">Local remodeling services</p><h2 class="section-title">Built for your home and your priorities.</h2></div><div data-reveal><p class="lead">{area.overview}</p><p>{area.planning}</p><ul>{area.priorities.map(item => <li>{item}</li>)}</ul></div></div></section>

    <section class="section service-section"><div class="container"><p class="section-label">What we remodel</p><h2 class="section-title">Complete {area.name} home improvements.</h2><div class="service-grid">{services.map(service => <article data-reveal><img src={service.image} alt={`${service.title} available in ${area.name}, Kentucky`} width="768" height="1024" loading="lazy" /><div><h3>{service.title}</h3><p>{service.copy}</p><a href={pageUrl('services')}>View service details →</a></div></article>)}</div></div></section>

    <section class="section process"><div class="container process-grid" data-reveal><div><p class="section-label">A straightforward approach</p><h2 class="section-title">From conversation to completed space.</h2></div><ol><li><span>01</span><div><h3>Share your project</h3><p>Tell us what you want to change, where the property is located, and what matters most.</p></div></li><li><span>02</span><div><h3>Define the work</h3><p>We discuss the relevant services and shape a remodeling scope around the home and your goals.</p></div></li><li><span>03</span><div><h3>Build with care</h3><p>We focus on coordinated execution, detailed finishes, and a result designed for everyday use.</p></div></li></ol></div></section>

    <section class="section projects"><div class="container"><div class="section-head"><div><p class="section-label">Project inspiration</p><h2 class="section-title">See the craftsmanship.</h2></div><a class="text-link" href={pageUrl('gallery')}>Full project gallery →</a></div><ProjectGallery limit={3} /></div></section>

    <section class="section faq"><div class="container faq-grid"><div><p class="section-label">Local remodeling questions</p><h2 class="section-title">Planning work in {area.name}?</h2></div><div>{faqs.map(item => <details><summary>{item.q}<span>+</span></summary><p>{item.a}</p></details>)}</div></div></section>

    <section class="nearby"><div class="container"><p>Also serving nearby Louisville communities:</p><div>{otherAreas.map(item => <a href={pageUrl(`areas/${item.slug}`)}>{item.name}</a>)}</div></div></section>
    <section class="local-cta"><div class="container"><p class="section-label">Start your {area.name} project</p><h2>Let’s talk about your home.</h2><p>Tell us what you want to improve and get the conversation started.</p><div><a class="btn btn-primary" href={pageUrl('contact')}>Request a free quote</a><a class="btn btn-outline" href="tel:+15026496975">Call 502-649-6975</a></div></div></section>
  </main><Footer />
</Layout>
<style>
  .local-hero{min-height:680px;position:relative;display:flex;align-items:center;color:#fff;overflow:hidden}.hero-image{position:absolute;inset:0;background:url('/images/kitchen-hero.jpg') center/cover}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.9),rgba(0,0,0,.42))}.hero-content{position:relative;z-index:1;padding-block:90px}.breadcrumbs{display:flex;gap:10px;color:rgba(255,255,255,.58);font-size:.72rem;margin-bottom:70px}.breadcrumbs a:hover{color:#fff}.local-hero h1{font-size:clamp(3.4rem,8vw,7rem);text-transform:uppercase;max-width:900px;letter-spacing:-.035em;margin:0 0 24px}.local-hero .hero-content>p:not(.page-label){max-width:650px;font-size:1.12rem;color:rgba(255,255,255,.78)}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}.intro-grid,.faq-grid,.process-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(50px,9vw,120px)}.local-intro .lead{font-size:1.25rem;font-weight:700;color:var(--text)}.local-intro p{color:var(--muted)}.local-intro ul{list-style:none;padding:0;margin:28px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:10px 24px}.local-intro li{border-bottom:1px solid var(--border);padding:10px 0;font-weight:700;font-size:.88rem}.local-intro li::before{content:'•';color:var(--orange);margin-right:10px}.service-section{background:var(--paper)}.service-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.service-grid article{display:grid;grid-template-columns:180px 1fr;background:#fff;min-height:250px}.service-grid img{width:100%;height:100%;object-fit:cover}.service-grid article>div{padding:30px}.service-grid h3{font-size:1.65rem;text-transform:uppercase;margin-bottom:12px}.service-grid p{color:var(--muted);font-size:.88rem}.service-grid a,.text-link{font-size:.7rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:var(--orange-dark)}.process{background:var(--black);color:#fff}.process .section-title{color:#fff}.process ol{list-style:none;margin:0;padding:0}.process li{display:grid;grid-template-columns:50px 1fr;gap:18px;border-top:1px solid rgba(255,255,255,.15);padding:24px 0}.process li:last-child{border-bottom:1px solid rgba(255,255,255,.15)}.process li>span{color:var(--orange);font-size:.7rem}.process h3{font-size:1.4rem;text-transform:uppercase;margin:0 0 8px}.process p{color:rgba(255,255,255,.62);margin:0}.section-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:38px}.section-head .section-title{margin:0}.faq details{border-top:1px solid var(--border);padding:22px 0}.faq details:last-child{border-bottom:1px solid var(--border)}.faq summary{list-style:none;cursor:pointer;font-weight:800;display:flex;justify-content:space-between;gap:20px}.faq summary::-webkit-details-marker{display:none}.faq summary span{color:var(--orange);font-size:1.4rem}.faq details[open] summary span{transform:rotate(45deg)}.faq details p{color:var(--muted);margin:14px 35px 0 0}.nearby{background:var(--paper);padding:30px 0}.nearby .container{display:flex;gap:25px;align-items:center;flex-wrap:wrap}.nearby p{font-weight:800;margin:0}.nearby .container>div{display:flex;gap:10px;flex-wrap:wrap}.nearby a{background:#fff;border:1px solid var(--border);padding:8px 12px;font-size:.75rem;font-weight:700}.nearby a:hover{border-color:var(--orange)}.local-cta{background:var(--black-soft);text-align:center;padding:clamp(75px,9vw,110px) 0;color:#fff}.local-cta h2{font-size:clamp(2.8rem,6vw,5rem);text-transform:uppercase;margin:0 0 16px}.local-cta>div>p:not(.section-label){color:rgba(255,255,255,.7)}.local-cta>div>div{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:30px}@media(max-width:900px){.service-grid{grid-template-columns:1fr}}@media(max-width:700px){.intro-grid,.faq-grid,.process-grid{grid-template-columns:1fr;gap:32px}.local-hero{min-height:650px}.breadcrumbs{margin-bottom:45px}.local-intro ul{grid-template-columns:1fr}.section-head{align-items:start;flex-direction:column;gap:20px}}@media(max-width:520px){.service-grid article{grid-template-columns:1fr}.service-grid img{height:220px}.local-hero h1{font-size:3.2rem}}
</style>
