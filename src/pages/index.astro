---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import CTABanner from '../components/CTABanner.astro'; import ProjectGallery from '../components/ProjectGallery.astro'; import { pageUrl } from '../utils/paths';
const services = [
  { href:`${pageUrl('services')}#bathroom`, number:'01', title:'Bathroom remodeling', copy:'Custom tile, walk-in showers, tub conversions, accessible layouts, and complete bathroom renovations.' },
  { href:`${pageUrl('services')}#kitchen`, number:'02', title:'Kitchen remodeling', copy:'Reconfigured layouts, cabinets, countertops, backsplashes, and finishes built around the way you live.' },
  { href:`${pageUrl('services')}#interior`, number:'03', title:'Interior renovations', copy:'Basement finishing, flooring, painting, doors, and wall changes—including load-bearing wall solutions.' },
  { href:`${pageUrl('services')}#exterior`, number:'04', title:'Exterior improvements', copy:'Decks, covered porches, fencing, windows, roofing, gutters, and complete exterior upgrades.' },
];
const faqs = [
  { q:'What areas do you serve?', a:'R&J Mills Remodeling serves Louisville, Kentucky and nearby communities, including St. Matthews, Crescent Hill, Jeffersontown, Fern Creek, and the Highlands.' },
  { q:'What types of remodeling projects do you handle?', a:'We handle bathroom and kitchen remodeling, basement finishing, interior improvements, decks, covered porches, fencing, windows, roofing, gutters, and other exterior work.' },
  { q:'How do I request a remodeling estimate?', a:'Call 502-649-6975 or use our contact form to tell us about your property, the work you are considering, and the best way to reach you.' },
];
const faqSchema = { '@context':'https://schema.org', '@type':'FAQPage', mainEntity:faqs.map(item => ({ '@type':'Question', name:item.q, acceptedAnswer:{ '@type':'Answer', text:item.a } })) };
---
<Layout title="Louisville Home Remodeling Contractor | R&J Mills Remodeling" description="Kitchen, bathroom, interior, and exterior remodeling in Louisville, KY. Explore local projects and request a free quote from R&J Mills Remodeling." schema={faqSchema} image="https://randjmills.com/wp-content/uploads/2025/02/kitchen-grey-2-768x1024.jpg">
  <Header />
  <main id="main-content">
    <section class="hero">
      <div class="hero-image" role="img" aria-label="Renovated Louisville home interior"></div><div class="hero-shade"></div>
      <div class="container hero-content">
        <p class="eyebrow">Louisville, Kentucky remodeling contractor</p>
        <h1>Crafted for<br/><span>how you live.</span></h1>
        <p class="hero-copy">Thoughtful kitchens, bathrooms, interiors, and outdoor spaces—built with care for Louisville homes.</p>
        <div class="hero-actions"><a href={pageUrl('contact')} class="btn btn-primary">Request a free quote</a><a href={pageUrl('gallery')} class="btn btn-outline">See our work</a></div>
      </div>
      <div class="hero-proof"><span>Local service</span><strong>Louisville + nearby communities</strong></div>
    </section>

    <section class="section intro"><div class="container intro-grid">
      <div data-reveal><p class="section-label">Built around your home</p><h2 class="section-title">One team. Every detail.</h2></div>
      <div class="intro-copy" data-reveal><p>R&amp;J Mills Remodeling transforms Louisville-area homes through practical planning, detailed craftsmanship, and a full range of interior and exterior services.</p><p>Whether you are opening up a kitchen, rebuilding a bathroom, finishing a basement, or adding a deck, we focus on a result that feels right for your space and holds up to daily life.</p><a href={pageUrl('about')} class="text-link">Meet R&amp;J Mills <span>→</span></a></div>
    </div></section>

    <section class="services section"><div class="container"><p class="section-label">Complete remodeling services</p><h2 class="section-title">From inside out.</h2><div class="service-list">
      {services.map(service => <a href={service.href} class="service-row" data-reveal><span class="service-number">{service.number}</span><h3>{service.title}</h3><p>{service.copy}</p><span class="arrow" aria-hidden="true">↗</span></a>)}
    </div></div></section>

    <section class="section work"><div class="container"><div class="section-head" data-reveal><div><p class="section-label">Recent work</p><h2 class="section-title">Made real.</h2></div><a href={pageUrl('gallery')} class="text-link">View all projects <span>→</span></a></div><ProjectGallery limit={6} /></div></section>

    <section class="section local"><div class="container local-grid" data-reveal><div><p class="section-label">Proudly serving Louisville</p><h2 class="section-title">Local knowledge matters.</h2><p>Homes across Louisville have different eras, layouts, and construction details. We bring a local perspective to projects in the city and surrounding communities.</p></div><div class="areas"><span>Louisville</span><span>St. Matthews</span><span>Crescent Hill</span><span>Jeffersontown</span><span>Fern Creek</span><span>The Highlands</span></div></div></section>

    <section class="section faq"><div class="container faq-grid"><div><p class="section-label">Quick answers</p><h2 class="section-title">Planning a remodel?</h2></div><div>{faqs.map(item => <details><summary>{item.q}<span>+</span></summary><p>{item.a}</p></details>)}</div></div></section>
    <CTABanner />
  </main><Footer />
</Layout>
<style>
  .hero{min-height:calc(100svh - 78px);position:relative;display:flex;align-items:center;color:#fff;overflow:hidden}.hero-image{position:absolute;inset:0;background:url('https://randjmills.com/wp-content/uploads/2025/02/pexels-itsterrymag-2635038-2048x1367.jpg') center/cover no-repeat;animation:heroZoom 16s ease-out both}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.9) 0%,rgba(0,0,0,.62) 48%,rgba(0,0,0,.12) 100%)}.hero-content{position:relative;padding-block:100px;z-index:1}.eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--orange);margin:0 0 22px}.hero h1{font-size:clamp(4rem,10vw,8.5rem);text-transform:uppercase;letter-spacing:-.045em;margin:0;max-width:900px}.hero h1 span{color:transparent;-webkit-text-stroke:1.5px #fff}.hero-copy{max-width:570px;font-size:clamp(1rem,2vw,1.2rem);color:rgba(255,255,255,.78);margin:28px 0 34px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.hero-proof{position:absolute;z-index:1;right:0;bottom:0;background:var(--orange);padding:20px 36px;display:flex;flex-direction:column}.hero-proof span{font-size:.64rem;text-transform:uppercase;letter-spacing:.14em}.hero-proof strong{font-size:.9rem}.intro-grid,.faq-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(50px,9vw,130px)}.intro-copy{font-size:1.08rem;color:var(--muted)}.intro-copy p:first-child{font-size:1.3rem;color:var(--text);font-weight:600}.text-link{display:inline-flex;gap:14px;align-items:center;border-bottom:2px solid var(--orange);padding-bottom:5px;font-weight:800;font-size:.78rem;letter-spacing:.1em;text-transform:uppercase}.text-link span{color:var(--orange);transition:transform .2s}.text-link:hover span{transform:translateX(4px)}
  .services{background:var(--black);color:#fff}.services .section-title{color:#fff}.service-list{border-top:1px solid rgba(255,255,255,.16)}.service-row{display:grid;grid-template-columns:60px 1fr 1.2fr 30px;gap:24px;align-items:center;padding:30px 10px;border-bottom:1px solid rgba(255,255,255,.16);transition:background .25s,padding .25s}.service-row:hover{background:rgba(255,255,255,.045);padding-inline:22px}.service-number{color:var(--orange);font-size:.7rem;letter-spacing:.1em}.service-row h3{font-size:clamp(1.5rem,3vw,2.3rem);text-transform:uppercase;margin:0}.service-row p{color:rgba(255,255,255,.6);font-size:.9rem;margin:0}.arrow{color:var(--orange);font-size:1.4rem}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:40px}.section-head .section-title{margin-bottom:0}.local{background:var(--paper)}.local-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:80px;align-items:center}.local p:not(.section-label){color:var(--muted);max-width:640px}.areas{display:grid;grid-template-columns:1fr 1fr}.areas span{padding:16px 8px;border-bottom:1px solid var(--border);font-weight:700}.areas span::before{content:'•';color:var(--orange);margin-right:10px}.faq details{border-top:1px solid var(--border);padding:22px 0}.faq details:last-child{border-bottom:1px solid var(--border)}.faq summary{list-style:none;cursor:pointer;font-weight:800;display:flex;justify-content:space-between;gap:20px}.faq summary::-webkit-details-marker{display:none}.faq summary span{color:var(--orange);font-size:1.4rem;line-height:1}.faq details[open] summary span{transform:rotate(45deg)}.faq details p{color:var(--muted);margin:14px 40px 0 0}@keyframes heroZoom{from{transform:scale(1.04)}to{transform:scale(1)}}
  @media(max-width:800px){.hero{min-height:720px}.hero-proof{display:none}.intro-grid,.faq-grid,.local-grid{grid-template-columns:1fr;gap:34px}.service-row{grid-template-columns:40px 1fr 24px}.service-row p{grid-column:2/4}.section-head{align-items:start;gap:24px;flex-direction:column}}@media(max-width:520px){.hero-shade{background:rgba(0,0,0,.7)}.hero h1{font-size:3.8rem}.areas{grid-template-columns:1fr}}
</style>
