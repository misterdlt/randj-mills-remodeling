---
import { pageUrl } from '../utils/paths';
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href={pageUrl()} class="footer-logo">
        <span class="footer-logo-main">R&amp;J Mills</span>
        <span class="footer-logo-sub">Remodeling</span>
      </a>
      <p class="footer-tagline">Building the Future, Restoring the Past.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <ul>
        <li><a href={pageUrl()}>Home</a></li>
        <li><a href={pageUrl('about')}>About</a></li>
        <li><a href={pageUrl('services')}>Services</a></li>
        <li><a href={pageUrl('areas')}>Areas We Serve</a></li>
        <li><a href={pageUrl('gallery')}>Projects</a></li>
        <li><a href={pageUrl('contact')}>Contact</a></li>
      </ul>
    </nav>

    <div class="footer-contact">
      <a href="tel:+15026496975" class="footer-contact-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
        </svg>
        502-649-6975
      </a>
      <a href="mailto:John.mills031790@gmail.com" class="footer-contact-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
        John.mills031790@gmail.com
      </a>
      <a href="https://www.facebook.com/RJMillsRemodeling/" target="_blank" rel="noopener noreferrer" class="footer-contact-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
        Facebook
      </a>
    </div>
  </div>

  <div class="container service-area-links" aria-label="Remodeling service areas">
    <span>Service Areas</span>
    <a href={pageUrl('areas/louisville-ky')}>Louisville</a>
    <a href={pageUrl('areas/st-matthews-ky')}>St. Matthews</a>
    <a href={pageUrl('areas/crescent-hill-ky')}>Crescent Hill</a>
    <a href={pageUrl('areas/jeffersontown-ky')}>Jeffersontown</a>
    <a href={pageUrl('areas/fern-creek-ky')}>Fern Creek</a>
    <a href={pageUrl('areas/highlands-ky')}>The Highlands</a>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} R&amp;J Mills Remodeling. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--black);
    color: rgba(255, 255, 255, 0.8);
    padding-top: 60px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.5fr;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-logo {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    margin-bottom: 16px;
  }
  .footer-logo-main {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
  }
  .footer-logo-sub {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .footer-tagline {
    font-size: 0.85rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
  }

  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-nav a {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    transition: color 0.2s;
  }
  .footer-nav a:hover { color: var(--color-accent); }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .footer-contact-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.65);
    transition: color 0.2s;
  }
  .footer-contact-item:hover { color: var(--color-accent); }

  .footer-bottom {
    padding: 20px 0;
    text-align: center;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.35);
  }
  .service-area-links { display:flex; justify-content:center; gap:10px 22px; flex-wrap:wrap; padding:22px 20px; border-bottom:1px solid rgba(255,255,255,.1); font-size:.73rem; }
  .service-area-links span { color:var(--orange); font-weight:800; text-transform:uppercase; letter-spacing:.1em; }
  .service-area-links a { color:rgba(255,255,255,.55); }
  .service-area-links a:hover { color:#fff; }
  .footer-bottom p { margin: 0; }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
