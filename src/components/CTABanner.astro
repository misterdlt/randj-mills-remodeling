---
import { pageUrl } from '../utils/paths';
---

<section class="cta-banner">
  <div class="container cta-inner">
    <p class="section-label">Start a conversation</p>
    <h2>Ready to make your home work better?</h2>
    <p class="cta-text">Serving Louisville, St. Matthews, Crescent Hill, Jeffersontown, Fern Creek, the Highlands, and nearby communities.</p>
    <div class="cta-actions"><a href={pageUrl('contact')} class="btn btn-primary">Request a free quote</a><a href="tel:+15026496975" class="btn btn-outline">Call 502-649-6975</a></div>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--black-soft);
    padding: clamp(72px, 9vw, 110px) 0;
    text-align: center;
  }

  .cta-inner {
    max-width: 800px;
  }
  h2 { color:#fff; font-size:clamp(2.3rem,5vw,4rem); text-transform:uppercase; margin-bottom:20px; }

  .cta-text {
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.1rem;
    line-height: 1.75;
    margin: 0 auto 32px;
    max-width: 680px;
  }

  .cta-actions { display:flex; justify-content:center; gap:12px; flex-wrap:wrap; }
</style>
